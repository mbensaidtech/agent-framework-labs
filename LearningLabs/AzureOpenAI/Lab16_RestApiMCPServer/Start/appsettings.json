{
  "OrdersApi": {
    "BaseUrl": "http://localhost:5300",
    "ApiKey": "dev-orders-mcp-server-key",
    "TimeoutSeconds": 10,
    "StartIfNotRunning": true
  },
  "OrdersMcpServer": {
    "BaseUrl": "http://localhost:5310",
    "Serve": false
  },
  "DevAuthorization": {
    "Clients": {
      "sales-agent": {
        "Secret": "dev-sales-agent-secret",
        "Scopes": "orders.read orders.write"
      },
      "reporting-agent": {
        "Secret": "dev-reporting-agent-secret",
        "Scopes": "orders.read"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "RestApiMCPServer": "Information",
      "ModelContextProtocol": "Critical"
    }
  }
}
