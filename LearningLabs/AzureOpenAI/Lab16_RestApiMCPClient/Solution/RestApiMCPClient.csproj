<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The AI agent of the CONSUMER team. It knows nothing about the REST microservice of the provider team:
    it only knows the URL of the remote MCP server and its own client credentials.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shared by every lab: set your Azure OpenAI secrets once with `dotnet user-secrets`. -->
    <UserSecretsId>microsoft-agent-framework-learninglabs</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework + OpenAI integration (brings OpenAI and Microsoft.Extensions.AI transitively). -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
    <!-- DefaultAzureCredential for Microsoft Entra ID authentication. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Configuration: appsettings.json, user secrets, environment variables. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <!-- Official MCP C# SDK: the MCP client (McpClient, HttpClientTransport, McpClientTool). -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\CommonUtilities\CommonUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
